{
  "$schema": "node_modules/wrangler/config-schema.json",
  // mcpkeel.app: a Next.js app built for Workers by @opennextjs/cloudflare.
  // Build and deploy from this folder with: npm run deploy
  "name": "mcpkeel-site",
  // worker.ts wraps the handler OpenNext generates, to set the security
  // headers and a per-request Content-Security-Policy nonce on every page.
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "mcpkeel-site" }],
  "observability": { "enabled": true },
  // The zone mcpkeel.app is on this Cloudflare account, so deploying creates
  // the DNS records and certificates for both hostnames.
  "routes": [
    { "pattern": "mcpkeel.app", "custom_domain": true },
    { "pattern": "www.mcpkeel.app", "custom_domain": true }
  ],
  // Workers Builds runs `npx wrangler preview` for every non-production
  // branch, and that command refuses to run without this block.
  "previews": {}
}
